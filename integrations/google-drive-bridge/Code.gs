const DEFAULT_SHEET_ID='1A24ypEXoOT-10j1V83Qzpn-PcGTwNxmfMB2YkuijeMo';
const TOKEN_KEY='BUILDWISE_BRIDGE_TOKEN';
function json(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function auth(e){var t=PropertiesService.getScriptProperties().getProperty(TOKEN_KEY);return t&&e.parameter.token===t}
function doGet(e){try{if(!auth(e))return json({error:'Unauthorized'});var a=e.parameter.action||'files';if(a==='files')return listFiles();if(a==='sheet')return readSheet(e.parameter.sheet_id||DEFAULT_SHEET_ID,e.parameter.gid);return json({error:'Unknown action'})}catch(err){return json({error:String(err.message||err)})}}
function listFiles(){var out=[],it=DriveApp.searchFiles("(mimeType='application/vnd.google-apps.spreadsheet' or mimeType='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet') and trashed=false');while(it.hasNext()){var f=it.next();out.push({id:f.getId(),name:f.getName(),mimeType:f.getMimeType(),url:f.getUrl(),updatedAt:f.getLastUpdated().toISOString()})}return json({ok:true,files:out.slice(0,200)})}
function readSheet(id,gid){var ss=SpreadsheetApp.openById(id),sh=gid?ss.getSheets().find(function(x){return String(x.getSheetId())===String(gid)}):ss.getSheets()[0];if(!sh)throw Error('Sheet not found');var v=sh.getDataRange().getValues();if(!v.length)return json({ok:true,rows:[],sheet_name:sh.getName()});var h=v[0].map(String),rows=v.slice(1).map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i]});return o});return json({ok:true,spreadsheet_id:id,sheet_name:sh.getName(),rows:rows})}